# Read directly by lxgo-kernel/config.Load (for a plain `go run .`) and,
# when running via Docker Compose (see ../docker-compose.yml; run from
# this directory), ALSO by docker-compose itself (auto-loaded from
# whichever directory the command is invoked from, for the host-side port
# mapping) - one file, both scenarios; the container gets its values from
# this same file too, bind-mounted in as runtime/.env.

APP_PORT=8092
APP_PORT_EXTERNAL=8092

# 0.0.0.0 works for both a plain local run and Docker - the WS listener has
# to bind every interface for a published container port to actually be
# reachable from outside the container at all.
WS_HOST=0.0.0.0
WS_PORT=8093
WS_PORT_EXTERNAL=8093

# The lobby itself (no path - see LobbyURL in config.yaml); empty disables
# announcing (this app is fully usable standalone).
LOBBY_URL=http://localhost:8090

# The full host:port a peer (the lobby above) should dial to reach this
# cartridge back - only needed when WS_HOST:WS_PORT above isn't itself
# dialable (e.g. WS_HOST=0.0.0.0 is a bind address, or the externally
# reachable port is WS_PORT_EXTERNAL rather than the container-internal
# WS_PORT) - see CartridgeAdvertiseAddr in config.yaml. Left empty, the
# WS_HOST:WS_PORT pair is announced as-is.
CARTRIDGE_ADVERTISE_ADDR=
