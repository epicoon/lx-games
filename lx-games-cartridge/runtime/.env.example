# Read directly by lxgo-kernel/config.Load (for a plain `go run .`) and,
# when running via Docker Compose (see ../docker-compose.yml; run from
# this directory), ALSO by docker-compose itself (auto-loaded from
# whichever directory the command is invoked from, for the host-side port
# mapping) - one file, both scenarios; the container gets its values from
# this same file too, bind-mounted in as runtime/.env.

APP_HOST=localhost
APP_PORT=8000
APP_PORT_EXTERNAL=8000

# The externally-reachable base URL for this cartridge's own static assets
# (images/css/js) - see StaticSrc in config.yaml. Defaults to this app's
# own origin (fine as long as the cartridge is directly reachable); point
# it at a CDN or other external host instead when it isn't.
STATIC_SRC=http://localhost:8000

# The lobby itself (no path - see LobbyURL in config.yaml); empty disables
# announcing (this app is fully usable standalone).
LOBBY_URL=http://localhost:8002

# The full host:port a peer (the lobby above) should dial to reach this
# cartridge back - only needed when "localhost:APP_PORT" isn't itself
# dialable (e.g. the externally reachable port is APP_PORT_EXTERNAL rather
# than the container-internal APP_PORT) - see CartridgeAdvertiseAddr in
# config.yaml. Left empty, "localhost:APP_PORT" is announced as-is.
CARTRIDGE_ADVERTISE_ADDR=
